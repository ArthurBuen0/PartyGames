# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# A chave PÚBLICA. Dois formatos circulam hoje, e os dois funcionam:
#   projetos novos  → sb_publishable_...   (em Project Settings → API Keys)
#   projetos antigos → eyJhbGciOi...       (rotulada "anon public")
#
# Pode ficar exposta no navegador: quem protege os dados é o RLS.
# NUNCA use a chave secreta aqui (sb_secret_... ou service_role) — ela ignora
# todas as políticas de segurança e daria acesso total ao banco.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
