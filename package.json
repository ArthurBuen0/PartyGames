{
  "name": "party-games",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Party Games — sala multiplayer em tempo real para jogos rápidos entre amigos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "node supabase/testes/rodar.mjs",
    "vitrine": "vite --open /vitrine.html",
    "sql:combinar": "node ferramentas/combinar-sql.mjs",
    "checar": "node ferramentas/checar-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
